---
layout: null
---
[
  {% assign first = true %}
  {% for fm in site.news %}
    {% if fm.title and fm.published != false %}
      {% if first %}{% assign first = false %}{% else %},{% endif %}
      {
        "title": {{ fm.title | jsonify }},
        "title_en": {{ fm.title_en | default: fm.title | jsonify }},
        "title_id": {{ fm.title_id | default: fm.title | jsonify }},
        "date": "{{ fm.date | date: '%Y-%m-%d' }}",
        "thumbnail": {{ fm.thumbnail | jsonify }},
        "status": {{ fm.status | jsonify }},
        "fileName": {{ fm.path | split: '/' | last | jsonify }}
      }
    {% endif %}
  {% endfor %}
]
