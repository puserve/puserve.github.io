---
layout: null
---
[
  {% for doc in site.repository %}
    {% if doc.title_en and doc.title_en != "" and doc.published != false %}
    {
      "title_en": {{ doc.title_en | jsonify }},
      "title_id": {{ doc.title_id | jsonify }},
      "date": "{{ doc.date | date: '%Y-%m-%d' }}",
      "category": {{ doc.category | jsonify }},
      "format": {{ doc.format | jsonify }},
      "size": {{ doc.size | jsonify }},
      "file_url": {{ doc.file_url | jsonify }},
      "fileName": {{ doc.path | split: '/' | last | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
