---
layout: null
---
[
  {% assign first = true %}
  {% for fm in site.events %}
    {% if fm.published != false %}
      {% if fm.title_en or fm.title_id %}
      {
        "title": {{ fm.title | jsonify }},
        "title_en": {{ fm.title_en | default: fm.title_id | default: fm.title | jsonify }},
        "title_id": {{ fm.title_id | default: fm.title_en | default: fm.title | jsonify }},
        "date": "{{ fm.date | date: '%Y-%m-%d %H:%M:%S' }}",
        "thumbnail": {{ fm.thumbnail | jsonify }},
        "status": {{ fm.status | jsonify }},
        "url": {{ fm.url | jsonify }}
      }
    {% endif %}
  {% endfor %}
]
