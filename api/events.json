---
layout: null
---
[
  {% for event in site.events %}
  {
    "title_en": {{ event.title_en | jsonify }},
    "title_id": {{ event.title_id | jsonify }},
    "date": "{{ event.date | date: '%Y-%m-%d' }}",
    "thumbnail": {{ event.thumbnail | jsonify }},
    "status": {{ event.status | jsonify }},
    "outcome_en": {{ event.outcome_en | jsonify }},
    "outcome_id": {{ event.outcome_id | jsonify }},
    "fileName": {{ event.path | split: '/' | last | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
